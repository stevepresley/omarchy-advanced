{
  "permissions": {
    "allow": [
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "WebFetch(domain:github.com)",
      "Bash(git revert:*)",
      "Bash(grep:*)",
      "mcp__ide__getDiagnostics",
      "Bash(env)",
      "Bash(git show:*)",
      "WebFetch(domain:api.github.com)",
      "Read(/tmp/**)",
      "Bash(git rev-parse:*)",
      "Bash(mkdir:*)",
      "Read(//tmp/**)"     
    ],
     "deny": []
  }
  ,
 "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/hook_processor.py"
          }
        ]
      }
    ],
	 "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/hook_processor.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/hook_processor.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/hook_processor.py"
          }
        ]
      }
    ],
	"SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/hook_processor.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/hook_processor.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/hook_processor.py"
          }
        ]
      }
    ]
  }
}