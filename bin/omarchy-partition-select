#!/bin/bash

# Interactive selector that lists disks plus their partitions and returns the chosen device path.
# Defaults to all block devices but accepts optional device arguments to limit the list.

# set OMARCHY_PATH and source presentation helpers
if [[ -z "${OMARCHY_PATH:-}" ]]; then
  export OMARCHY_PATH="/root/omarchy"
fi

set -euo pipefail

source "$OMARCHY_PATH/install/helpers/presentation.sh"
error_message=""

if command -v gum >/dev/null 2>&1; then
  selector_cmd=("gum" "choose" "--header" "Select install target (disk or partition)")
else
  echo "Error: gum is required for omarchy-partition-select" >&2
  exit 1
fi

if ! command -v lsblk >/dev/null 2>&1; then
  echo "Error: lsblk is required for omarchy-partition-select" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: jq is required for omarchy-partition-select" >&2
  exit 1
fi

# Allow passing specific block devices (useful for testing)
if (($# > 0)); then
  devices=("$@")
else
  mapfile -t devices < <(lsblk -dpno PATH | grep -E '/dev/(sd|hd|vd|nvme|mmcblk|xv)')
fi

if ((${#devices[@]} == 0)); then
  echo "No block devices found." >&2
  exit 1
fi

# Gather metadata for the requested devices using lsblk JSON for easier traversal
lsblk_columns="PATH,NAME,TYPE,SIZE,FSTYPE,MOUNTPOINT,LABEL,MODEL,PARTLABEL,PKNAME"
lsblk_json=$(lsblk -J -o "$lsblk_columns" "${devices[@]}")

# Prepare formatted lines for gum choose
mapfile -t options < <(
  jq -r '
    def fmt_size($val):
      if $val == null or $val == "" then "" else " (" + $val + ")" end;
    def fmt_model($val):
      if $val == null or $val == "" then "" else " - " + $val end;
    def fmt_fs($part):
      if $part.fstype != null and $part.fstype != "" then
        ", " + $part.fstype
        + (if $part.fstype == "crypto_LUKS" then " \u001b[31m(ENCRYPTED)\u001b[0m" else "" end)
      else "" end;
    def fmt_mount($part):
      if $part.mountpoint != null and $part.mountpoint != "" then ", mounted at " + $part.mountpoint else "" end;
    def fmt_label($part):
      if $part.partlabel != null and $part.partlabel != "" then " [" + $part.partlabel + "]"
      elif $part.label != null and $part.label != "" then " [" + $part.label + "]"
      else "" end;
    def fmt_size_warning($val):
      if $val == null or $val == "" then ""
      else
        # Parse size string to bytes
        if ($val | test("[0-9]+G")) then
          ($val | scan("[0-9]+") | tonumber * 1024 * 1024 * 1024) as $bytes |
          if $bytes < (16 * 1024 * 1024 * 1024) then " \u001b[31m[TOO SMALL - 16GB minimum required]\u001b[0m" else "" end
        else ""
        end
       end;

    .blockdevices[]
    | select(.type == "disk")
    | . as $disk
    | ($disk.path + fmt_size($disk.size) + fmt_model($disk.model))
    , (($disk.children // [])
        | to_entries[]
        | . as $entry
        | $entry.value as $part
        | ($disk.path) as $disk_path
        | ($entry.key == ( ( ($disk.children // []) | length) - 1 )) as $is_last
        | (if $is_last then "  └─ " else "  ├─ " end)
          + ($part.path
             + fmt_size($part.size)
             + fmt_fs($part)
             + fmt_mount($part)
             + fmt_label($part)
             + fmt_size_warning($part.size)))
  ' <<<"$lsblk_json"
)

filtered_options=()
min_size_bytes=$((14 * 1024 * 1024 * 1024))
for line in "${options[@]}"; do
  device=$(printf "%s\n" "$line" | grep -oE '/dev/[a-z0-9]+' | tail -1)
  if [[ "$line" =~ [└├] && -n "$device" ]]; then
    size_bytes=$(lsblk -dno SIZE -b "$device" 2>/dev/null | numfmt --from=iec 2>/dev/null || echo 0)
    if (( size_bytes < min_size_bytes )); then
      continue
    fi
  fi
  filtered_options+=("$line")
done
options=("${filtered_options[@]}")

if ((${#options[@]} == 0)); then
  echo "No disks or partitions found to display." >&2
  exit 1
fi

while true; do

  header_text="Select install target (disk or partition)"
  selected="$("gum" "choose" "--header" "$error_message
$header_text" "--padding" "0 $PADDING_LEFT" "${options[@]}")"

  #selected="$("gum" "choose" "--padding" "1 $PADDING_LEFT" "${options[@]}")"
  error_message=""
  if [[ $? -ne 0 ]]; then
    exit 1
  fi
  device=$(printf "%s\n" "$selected" | grep -oE '/dev/[a-z0-9]+' | tail -1)
  partition_size_bytes=$(lsblk -dno SIZE -b "$device" 2>/dev/null | numfmt --from=iec 2>/dev/null || echo 0)
  min_size_bytes=$((16 * 1024 * 1024 * 1024))
  if (( partition_size_bytes >= min_size_bytes )); then
    printf "%s\n" "$device"
    break
  else
   # partition_size_display=$(num fmt --to=iec-i --suffix=B $partition_size_bytes 2>/dev/null || echo "unknown size")
   # gum style --bold --foreground 1 "Error: $device is $partition_size_display.
   error_message="Error: $device is too small ($(numfmt --to=iec-i --suffix=B $partition_size_bytes) bytes).  Minimum required is 16GB. Please select a different partition."
  fi
done
