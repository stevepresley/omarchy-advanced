#!/bin/bash

# Partition selector using parted as single source of truth
# Parse 'parted disk print free' output to extract both partitions and free space regions
# in correct order and with correct boundaries
# Usage: omarchy-partition-select [debug]
#   debug: optional, set to "true" to show detailed debug output (default: false)

set -euo pipefail

if [[ -z "${OMARCHY_PATH:-}" ]]; then
  export OMARCHY_PATH="/root/omarchy"
fi

source "$OMARCHY_PATH/install/helpers/presentation.sh"
error_message=""
CONFIG_LOG="/tmp/partition-select.log"
touch "$CONFIG_LOG" 2>/dev/null || true

log_debug() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$CONFIG_LOG"
}

# Parse command line arguments
# Usage: omarchy-partition-select [debug|display]
#   debug: set to "true" to show internal debug output (default: false)
#   display: show the disk layout map instead of interactive menu
DEBUG=false
DISPLAY=false

# Parse parameters
for param in "$@"; do
  case "$param" in
    true|debug)
      DEBUG=true
      ;;
    display)
      DISPLAY=true
      ;;
  esac
done

# Helper function for debug output
debug_echo() {
  if [[ "$DEBUG" == "true" ]]; then
    echo "$@" >&2
  fi
}

# === PARTITION PREP FUNCTIONS (copied from -original) ===

prepare_disk_for_repartitioning() {
  local disk="$1"
  log_debug "Detaching existing mappings on $disk"
  {
    echo "--- lsblk tree for /dev/$disk ---"
    lsblk -lnpo NAME,TYPE,MOUNTPOINTS "/dev/$disk"
    echo "--- /proc/swaps ---"
    cat /proc/swaps
  } >>"$CONFIG_LOG" 2>&1

  while read -r child child_type; do
    [[ -z "$child" ]] && continue
    log_debug "Processing child $child (type=$child_type)"
    case "$child_type" in
      part)
        if awk 'NR>1 {print $1}' /proc/swaps 2>/dev/null | grep -Fxq "$child"; then
          log_debug "swapoff $child"
          swapoff "$child" >>"$CONFIG_LOG" 2>&1 || log_debug "swapoff failed for $child"
        fi
        mapfile -t targets < <(findmnt -rn "$child" -o TARGET 2>/dev/null || true)
        if ((${#targets[@]})); then
          mapfile -t targets < <(printf '%s\n' "${targets[@]}" | awk 'NF' | sort -r)
        fi
        for target in "${targets[@]}"; do
          [[ -z "$target" ]] && continue
          log_debug "umount $target"
          if ! umount "$target" >>"$CONFIG_LOG" 2>&1; then
            log_debug "umount failed for $target, retrying with -R"
            umount -R "$target" >>"$CONFIG_LOG" 2>&1 || log_debug "umount -R failed for $target"
          fi
        done
        ;;
      crypt)
        mapfile -t targets < <(findmnt -rn "$child" -o TARGET 2>/dev/null || true)
        if ((${#targets[@]})); then
          mapfile -t targets < <(printf '%s\n' "${targets[@]}" | awk 'NF' | sort -r)
        fi
        for target in "${targets[@]}"; do
          [[ -z "$target" ]] && continue
          log_debug "umount $target (crypt)"
          if ! umount "$target" >>"$CONFIG_LOG" 2>&1; then
            log_debug "umount failed for $target, retrying with -R"
            umount -R "$target" >>"$CONFIG_LOG" 2>&1 || log_debug "umount -R failed for $target"
          fi
        done
        if command -v cryptsetup >/dev/null 2>&1; then
          local mapper_name
          mapper_name=$(lsblk -no NAME "$child" 2>/dev/null | head -n1)
          if [[ -n "$mapper_name" ]]; then
            log_debug "Closing LUKS mapping $mapper_name"
            cryptsetup close "$mapper_name" >>"$CONFIG_LOG" 2>&1 || log_debug "Failed to close $mapper_name"
          fi
        fi
        ;;
      *)
        log_debug "No cleanup actions for child type $child_type"
        ;;
    esac
  done < <(lsblk -lnpo NAME,TYPE "/dev/$disk" | tail -n +2)

  if command -v udevadm >/dev/null 2>&1; then
    udevadm settle >>"$CONFIG_LOG" 2>&1 || true
  fi
}

refresh_partition_table() {
  local disk="$1"
  log_debug "Refreshing partition table on $disk"
  partprobe "/dev/$disk" >>"$CONFIG_LOG" 2>&1 || true
  if command -v udevadm >/dev/null 2>&1; then
    udevadm settle >>"$CONFIG_LOG" 2>&1 || true
  fi
}

find_partition_boundaries() {
  local disk="$1"
  local is_empty_disk="$2"  # true for whole disk, false for partition replacement

  # Output variables will be set as echo statements
  local parted_output
  local free_start
  local free_end
  local free_size_str
  local free_size_num
  local free_num
  local esp_end_num
  local esp_end
  local root_end

  if [[ "$is_empty_disk" == "true" ]]; then
    # For empty disk, entire disk is free space (start=0, end=100%)
    log_debug "Empty disk - using full disk boundaries for partitions"
    free_start="0"
    free_end="100%"
    esp_end="2049MiB"
    root_end="100%"
  else
    # Extract free space boundaries dynamically using parted print free
    log_debug "Extracting free space boundaries from /dev/$disk"
    log_debug "Running command: parted /dev/$disk print free"
    parted_output=$(parted /dev/$disk print free 2>/dev/null)
    log_debug "=== parted print free output for /dev/$disk ==="
    echo "$parted_output" | while read line; do
      log_debug "PARTED: $line"
    done
    log_debug "=== end parted output ==="

    # Find the first free space region that is >= 2GB (2048MB)
    free_start=""
    free_end=""

    while IFS=$'|' read -r free_start free_end free_size_str; do
      if [[ -z "$free_start" ]]; then
        continue
      fi

      # Extract numeric value and unit from size string
      free_size_str=$(echo "$free_size_str" | xargs)
      free_size_num=$(echo "$free_size_str" | grep -oE '^[0-9]+\.?[0-9]*')
      free_unit=$(echo "$free_size_str" | grep -oE '[A-Z]+$')

      # Convert to MB for comparison
      case "$free_unit" in
        GB)
          free_size_num=$(echo "$free_size_num * 1024" | bc -l | awk '{printf "%.0f", $0}')
          ;;
        MB)
          free_size_num=$(echo "$free_size_num" | awk '{printf "%.0f", $0}')
          ;;
        *)
          free_size_num=$(echo "$free_size_num / 1024" | bc -l | awk '{printf "%.0f", $0}')
          ;;
      esac

      log_debug "Found free space: $free_start to $free_end, size: $free_size_str (converted to ${free_size_num}MB)"

      if (( free_size_num >= 2048 )); then
        log_debug "Selected free space: $free_start to $free_end (${free_size_num}MB available)"
        break
      fi
    done < <(echo "$parted_output" | awk '/Free Space/ {print $1 "|" $2 "|" $3}')

    if [[ -z "$free_start" ]] || [[ -z "$free_end" ]]; then
      echo "Error: No free space region with at least 2GB available found on $disk" >&2
      log_debug "Failed to find 2GB+ free space region on $disk"
      return 1
    fi

    # Calculate ESP end
    free_num=$(echo "$free_start" | sed 's/[^0-9]//g')
    esp_end_num=$((free_num + 2048))
    esp_end="${esp_end_num}MB"
    log_debug "Calculated ESP boundaries: $free_start to $esp_end"

    # Determine root partition end boundary
    local partitions_after_free_space
    partitions_after_free_space=$(parted -s "/dev/$disk" print 2>/dev/null | awk -v free_end="$free_end" '
      /^[[:space:]]*[0-9]+/ {
        partition_end=$3
        partition_end_num=partition_end
        gsub(/[A-Za-z]+$/, "", partition_end_num)
        free_end_num=free_end
        gsub(/[A-Za-z]+$/, "", free_end_num)
        if (partition_end_num + 0 > free_end_num + 0) {
          print "yes"
          exit
        }
      }
    ')

    if [[ -n "$partitions_after_free_space" ]]; then
      root_end="$free_end"
      log_debug "Partitions exist after free space - using free_end ($free_end) as root partition boundary"
    else
      root_end="100%"
      log_debug "No partitions after free space - using disk end (100%) as root partition boundary"
    fi
  fi

  # Output boundaries for caller to use
  echo "$free_start|$esp_end|$root_end"
}

prepare_disk_layout() {
  local disk="$1"
  local boot_partition
  local root_partition
  local boundaries

  prepare_disk_for_repartitioning "$disk"

  log_debug "Creating ESP and root partitions on $disk"
  if ! wipefs -a "/dev/$disk" >>"$CONFIG_LOG" 2>&1; then
    log_debug "wipefs failed on $disk"
    echo "Error: Failed to wipe disk signatures" >&2
    return 1
  fi
  refresh_partition_table "$disk"

  if ! parted -s "/dev/$disk" mklabel gpt >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to create GPT label" >&2
    return 1
  fi
  refresh_partition_table "$disk"

  # Get partition boundaries - use true for empty disk
  boundaries=$(find_partition_boundaries "$disk" "true") || return 1
  IFS='|' read -r free_start esp_end root_end <<<"$boundaries"

  log_debug "Creating ESP partition: $free_start to $esp_end"
  if ! parted -s "/dev/$disk" mkpart primary fat32 "$free_start" "$esp_end" >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to create FAT32 boot partition" >&2
    return 1
  fi
  refresh_partition_table "$disk"

  parted -s "/dev/$disk" set 1 esp on >>"$CONFIG_LOG" 2>&1 || { echo "Error: Failed to mark ESP partition" >&2; return 1; }
  refresh_partition_table "$disk"

  log_debug "Creating root partition: $esp_end to $root_end"
  if ! parted -s "/dev/$disk" mkpart primary btrfs "$esp_end" "$root_end" >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to create root partition" >&2
    return 1
  fi
  refresh_partition_table "$disk"

  log_debug "Created boot and root partitions on $disk"

  # === FORMAT PARTITIONS AND CREATE SUBVOLUMES ===
  boot_partition="/dev/${disk}1"
  root_partition="/dev/${disk}2"

  log_debug "Formatting ESP partition: $boot_partition"
  if ! mkfs.fat -F 32 "$boot_partition" >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to format ESP partition" >&2
    return 1
  fi

  log_debug "Formatting root partition: $root_partition as Btrfs"
  if ! mkfs.btrfs -f "$root_partition" >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to format root partition as Btrfs" >&2
    return 1
  fi

  # Create mount point
  mkdir -p /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || { echo "Error: Failed to create mount point" >&2; return 1; }

  log_debug "Mounting root partition with compression"
  if ! mount -o compress=zstd "$root_partition" /mnt/archinstall >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to mount root partition" >&2
    return 1
  fi

  log_debug "Creating BTRFS subvolumes"
  if ! btrfs subvolume create /mnt/archinstall/@ >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to create @ subvolume" >&2
    umount /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || true
    return 1
  fi

  if ! btrfs subvolume create /mnt/archinstall/@home >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to create @home subvolume" >&2
    umount /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || true
    return 1
  fi

  if ! btrfs subvolume create /mnt/archinstall/@log >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to create @log subvolume" >&2
    umount /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || true
    return 1
  fi

  if ! btrfs subvolume create /mnt/archinstall/@pkg >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to create @pkg subvolume" >&2
    umount /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || true
    return 1
  fi

  log_debug "Unmounting to remount with subvolumes"
  if ! umount /mnt/archinstall >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to unmount root partition" >&2
    return 1
  fi

  log_debug "Remounting with subvolumes"
  if ! mount -o compress=zstd,subvol=@ "$root_partition" /mnt/archinstall >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to mount @ subvolume" >&2
    return 1
  fi

  # Create subdirectories for other subvolumes
  mkdir -p /mnt/archinstall/{home,var/log,var/cache/pacman/pkg} >>"$CONFIG_LOG" 2>&1 || { echo "Error: Failed to create subdirectories" >&2; umount /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || true; return 1; }

  if ! mount -o compress=zstd,subvol=@home "$root_partition" /mnt/archinstall/home >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to mount @home subvolume" >&2
    umount /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || true
    return 1
  fi

  if ! mount -o compress=zstd,subvol=@log "$root_partition" /mnt/archinstall/var/log >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to mount @log subvolume" >&2
    umount -R /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || true
    return 1
  fi

  if ! mount -o compress=zstd,subvol=@pkg "$root_partition" /mnt/archinstall/var/cache/pacman/pkg >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to mount @pkg subvolume" >&2
    umount -R /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || true
    return 1
  fi

  log_debug "Mounting boot partition at /mnt/archinstall/boot"
  mkdir -p /mnt/archinstall/boot >>"$CONFIG_LOG" 2>&1 || { echo "Error: Failed to create boot directory" >&2; umount -R /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || true; return 1; }
  if ! mount "$boot_partition" /mnt/archinstall/boot >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to mount boot partition" >&2
    umount -R /mnt/archinstall >>"$CONFIG_LOG" 2>&1 || true
    return 1
  fi

  log_debug "All partitions formatted, subvolumes created, and mounted successfully"

  # Final refresh to ensure all device nodes are properly settled before returning
  # This ensures the configurator can access the mounted partitions without delay
  refresh_partition_table "$disk"
}

prepare_partition_layout() {
  local partition="$1"
  local disk
  local partnum
  local boundaries
  local free_start
  local esp_end
  local root_end

  disk=$(lsblk -no PKNAME "$partition" 2>/dev/null | head -n1)
  [[ -z "$disk" ]] && { echo "Error: Failed to determine disk for partition $partition" >&2; return 1; }

  partnum="${partition##*[!0-9]}"
  [[ -z "$partnum" ]] && { echo "Error: Failed to extract partition number from $partition" >&2; return 1; }

  log_debug "Replacing selected partition with ESP + root partitions"

  log_debug "Deleting partition $partnum from disk $disk"

  prepare_disk_for_repartitioning "$disk"

  if ! parted -s "/dev/$disk" rm "$partnum" >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to delete partition $partition from $disk" >&2
    return 1
  fi
  log_debug "Partition $partnum deleted successfully"

  refresh_partition_table "$disk"

  # Get partition boundaries using refactored function - use false for existing partitions
  boundaries=$(find_partition_boundaries "$disk" "false") || return 1
  IFS='|' read -r free_start esp_end root_end <<<"$boundaries"

  log_debug "Creating new ESP partition on $disk"
  if ! parted -s "/dev/$disk" mkpart primary fat32 "$free_start" "$esp_end" >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to create ESP partition on $disk" >&2
    return 1
  fi
  refresh_partition_table "$disk"

  if ! parted -s "/dev/$disk" set 1 esp on >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to mark ESP partition" >&2
    return 1
  fi
  refresh_partition_table "$disk"

  log_debug "Creating new root partition on $disk"
  if ! parted -s "/dev/$disk" mkpart primary btrfs "$esp_end" "$root_end" >>"$CONFIG_LOG" 2>&1; then
    echo "Error: Failed to create root partition on $disk" >&2
    return 1
  fi
  refresh_partition_table "$disk"

  log_debug "Successfully replaced partition with new ESP and root on $disk"
}

# === END PARTITION PREP FUNCTIONS ===

# === BUILD UNIFIED MAPFILE FROM PARTED OUTPUT ===
# Structure: disk|label|start_mb|end_mb|size_mb|type
# Extracts both partitions AND free space from single parted command per disk

build_unified_mapfile() {
  local -n result=$1
  local disks
  local temp_file

  result=()
  temp_file=$(mktemp)

  debug_echo "DEBUG: [$(date '+%Y-%m-%d %H:%M:%S')] Starting build_unified_mapfile"

  # Get all disk names only - exclude loop devices (major 7) and sr/cd-rom (major 11)
  disks=$(lsblk -e7,11 -nd -o NAME 2>/dev/null || true)

  debug_echo "DEBUG: Found disks: '$disks'"
  debug_echo "DEBUG: Disk list line count: $(echo "$disks" | wc -l)"

  while read -r disk; do
    [[ -z "$disk" ]] && continue

    debug_echo "DEBUG: Processing disk: $disk"

    # Get BOTH partitions AND free space from single parted command
    local parted_output
    parted_output=$(sudo parted "/dev/$disk" print free 2>/dev/null || echo "")

    debug_echo "DEBUG: Parted output for /dev/$disk:"
    if [[ "$DEBUG" == "true" ]]; then
      echo "$parted_output" | sed 's/^/DEBUG:   /' >&2
    fi

    # Parse parted output for both partition lines and free space lines
    echo "$parted_output" | awk -v disk="$disk" -v debug="$DEBUG" '
      BEGIN {
        if (debug == "true") {
          print "DEBUG AWK: Starting parse for disk " disk > "/dev/stderr"
        }
      }

      # Skip header/footer lines and empty lines
      /^[[:space:]]*$/ {
        if (debug == "true") {
          print "DEBUG AWK: Skipping empty line" > "/dev/stderr"
        }
        next
      }
      /^Number/ {
        if (debug == "true") {
          print "DEBUG AWK: Skipping Number header" > "/dev/stderr"
        }
        next
      }
      /^Disk / {
        if (debug == "true") {
          print "DEBUG AWK: Skipping Disk header" > "/dev/stderr"
        }
        next
      }
      /^Sector/ {
        if (debug == "true") {
          print "DEBUG AWK: Skipping Sector header" > "/dev/stderr"
        }
        next
      }
      /^Partition Table/ {
        if (debug == "true") {
          print "DEBUG AWK: Skipping Partition Table header" > "/dev/stderr"
        }
        next
      }
      /^Disk Flags/ {
        if (debug == "true") {
          print "DEBUG AWK: Skipping Disk Flags header" > "/dev/stderr"
        }
        next
      }
      /^Model:/ {
        if (debug == "true") {
          print "DEBUG AWK: Skipping Model header" > "/dev/stderr"
        }
        next
      }

      {
        line_copy = $0
        # Trim leading whitespace
        gsub(/^[[:space:]]+/, "")

        if (debug == "true") {
          print "DEBUG AWK: Processing line (after trim): [" $0 "]" > "/dev/stderr"
        }

        # Check if line starts with a digit (partition number)
        if ($0 ~ /^[0-9]+[[:space:]]/) {
          if (debug == "true") {
            print "DEBUG AWK: Found partition line: " line_copy > "/dev/stderr"
          }

          # Extract partition number (first token)
          partition_num = $1
          # Start is second token
          start_str = $2
          # End is third token
          end_str = $3

          if (debug == "true") {
            print "DEBUG AWK:   partition_num=" partition_num " start_str=" start_str " end_str=" end_str > "/dev/stderr"
          }

          # Verify we have valid unit suffixes
          if (start_str !~ /[kMG]?B$/ || end_str !~ /[kMG]?B$/) {
            if (debug == "true") {
              print "DEBUG AWK:   FAILED unit suffix check" > "/dev/stderr"
            }
            next
          }
          if (debug == "true") {
            print "DEBUG AWK:   PASSED unit suffix check" > "/dev/stderr"
          }

          # Convert start to MB
          if (start_str ~ /GB$/) {
            start_mb = substr(start_str, 1, length(start_str)-2) * 1024
          } else if (start_str ~ /MB$/) {
            start_mb = substr(start_str, 1, length(start_str)-2)
          } else if (start_str ~ /kB$/) {
            start_mb = substr(start_str, 1, length(start_str)-2) / 1024
          } else if (start_str ~ /B$/) {
            start_mb = substr(start_str, 1, length(start_str)-1) / 1048576
          } else {
            if (debug == "true") {
              print "DEBUG AWK:   FAILED to convert start_str unit" > "/dev/stderr"
            }
            next
          }

          # Convert end to MB
          if (end_str ~ /GB$/) {
            end_mb = substr(end_str, 1, length(end_str)-2) * 1024
          } else if (end_str ~ /MB$/) {
            end_mb = substr(end_str, 1, length(end_str)-2)
          } else if (end_str ~ /kB$/) {
            end_mb = substr(end_str, 1, length(end_str)-2) / 1024
          } else if (end_str ~ /B$/) {
            end_mb = substr(end_str, 1, length(end_str)-1) / 1048576
          } else {
            if (debug == "true") {
              print "DEBUG AWK:   FAILED to convert end_str unit" > "/dev/stderr"
            }
            next
          }

          size_mb = int(end_mb - start_mb)
          partition_name = disk partition_num
          if (debug == "true") {
            print "DEBUG AWK:   Outputting partition: " disk "|" partition_name "|" start_mb "|" end_mb "|" size_mb "|part" > "/dev/stderr"
          }
          printf "%s|%s|%.0f|%.0f|%d|part\n", disk, partition_name, start_mb, end_mb, size_mb
          next
        }

        # Check if line contains "Free Space" (after trimming leading space)
        if ($0 ~ /Free Space/) {
          if (debug == "true") {
            print "DEBUG AWK: Found free space line: " line_copy > "/dev/stderr"
          }

          # Start is first token, end is second token
          start_str = $1
          end_str = $2

          if (debug == "true") {
            print "DEBUG AWK:   start_str=" start_str " end_str=" end_str > "/dev/stderr"
          }

          # Verify we have valid unit suffixes
          if (start_str !~ /[kMG]?B$/ || end_str !~ /[kMG]?B$/) {
            if (debug == "true") {
              print "DEBUG AWK:   FAILED unit suffix check" > "/dev/stderr"
            }
            next
          }
          if (debug == "true") {
            print "DEBUG AWK:   PASSED unit suffix check" > "/dev/stderr"
          }

          # Convert start to MB
          if (start_str ~ /GB$/) {
            start_mb = substr(start_str, 1, length(start_str)-2) * 1024
          } else if (start_str ~ /MB$/) {
            start_mb = substr(start_str, 1, length(start_str)-2)
          } else if (start_str ~ /kB$/) {
            start_mb = substr(start_str, 1, length(start_str)-2) / 1024
          } else if (start_str ~ /B$/) {
            start_mb = substr(start_str, 1, length(start_str)-1) / 1048576
          } else {
            if (debug == "true") {
              print "DEBUG AWK:   FAILED to convert start_str unit" > "/dev/stderr"
            }
            next
          }

          # Convert end to MB
          if (end_str ~ /GB$/) {
            end_mb = substr(end_str, 1, length(end_str)-2) * 1024
          } else if (end_str ~ /MB$/) {
            end_mb = substr(end_str, 1, length(end_str)-2)
          } else if (end_str ~ /kB$/) {
            end_mb = substr(end_str, 1, length(end_str)-2) / 1024
          } else if (end_str ~ /B$/) {
            end_mb = substr(end_str, 1, length(end_str)-1) / 1048576
          } else {
            if (debug == "true") {
              print "DEBUG AWK:   FAILED to convert end_str unit" > "/dev/stderr"
            }
            next
          }

          size_mb = int(end_mb - start_mb)
          if (size_mb < 2048) {
            next
          }
          if (debug == "true") {
            print "DEBUG AWK:   Outputting free space: " disk "|free|" start_mb "|" end_mb "|" size_mb "|free" > "/dev/stderr"
          }
          printf "%s|free|%.0f|%.0f|%d|free\n", disk, start_mb, end_mb, size_mb
          next
        }
      }

      END {
        if (debug == "true") {
          print "DEBUG AWK: Finished parsing disk " disk > "/dev/stderr"
        }
      }
    ' >> "$temp_file"
  done <<< "$disks"

  debug_echo "DEBUG: Temp file contents:"
  if [[ "$DEBUG" == "true" ]]; then
    cat "$temp_file" | sed 's/^/DEBUG:   /' >&2
  fi

  # Read from temp file and populate array
  while IFS='|' read -r disk label start end size type; do
    result+=("$disk|$label|$start|$end|$size|$type")
  done < "$temp_file"

  rm -f "$temp_file"
}

# === SORT MAPFILE BY DISK AND POSITION ===

sort_mapfile() {
  local -n entries=$1
  local -n result=$2
  local temp_file
  local temp_sorted

  result=()
  temp_file=$(mktemp)
  temp_sorted=$(mktemp)

  # Write all entries to temp file
  for entry in "${entries[@]}"; do
    echo "$entry" >> "$temp_file"
  done

  # Sort by: disk name (field 1), then by start position (field 3 numerically)
  sort -t'|' -k1,1 -k3,3n "$temp_file" > "$temp_sorted"

  # Read sorted file into array
  while IFS='|' read -r disk label start end size type; do
    result+=("$disk|$label|$start|$end|$size|$type")
  done < "$temp_sorted"

  rm -f "$temp_file" "$temp_sorted"
}

# === DISPLAY MERGED MAP ===

display_merged_map() {
  local -n merged=$1

  echo "=== Disk Layout Map ==="
  echo ""

  if [[ ${#merged[@]} -eq 0 ]]; then
    echo "No partitions or free space found"
    return
  fi

  local current_disk=""
  for entry in "${merged[@]}"; do
    IFS='|' read -r disk label start end size type <<< "$entry"

    # New disk header
    if [[ "$disk" != "$current_disk" ]]; then
      [[ -n "$current_disk" ]] && echo ""
      echo "Disk: /dev/$disk"
      echo "  Position (MB) | Label | Size (MB) | Type"
      echo "  ============================================"
      current_disk="$disk"
    fi

    printf "  %6s - %-6s | %-15s | %8s | %s\n" "$start" "$end" "$label" "$size" "$type"
  done
}

# === GUM CHOOSE INTEGRATION ===

# Check for required dependencies
if ! command -v gum >/dev/null 2>&1; then
  echo "Error: gum is required for omarchy-partition-select-revised" >&2
  exit 1
fi

if ! command -v lsblk >/dev/null 2>&1; then
  echo "Error: lsblk is required for omarchy-partition-select-revised" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: jq is required for omarchy-partition-select-revised" >&2
  exit 1
fi

# Build gum menu options from the unified mapfile
build_gum_options() {
  local -n merged=$1
  local -n options=$2

  options=()

  debug_echo "DEBUG: Building gum menu options from mapfile"

  local current_disk=""
  local last_disk=""
  local i=0
  local next_disk=""

  for i in "${!merged[@]}"; do
    entry="${merged[$i]}"
    IFS='|' read -r disk label start end size type <<< "$entry"

    # Look ahead to see if next entry is a different disk
    if (( i + 1 < ${#merged[@]} )); then
      IFS='|' read -r next_disk _ _ _ _ _ <<< "${merged[$((i+1))]}"
    else
      next_disk=""  # Last entry
    fi

    # New disk section - add disk as selectable option
    if [[ "$disk" != "$current_disk" ]]; then
      current_disk="$disk"
      last_disk="/dev/$disk"
      # Disk entries are presented without tree prefix
      options+=("$last_disk")
      debug_echo "DEBUG: Added disk option: $last_disk"
    fi

    # Determine tree prefix: └─ if this is the last entry for this disk, ├─ otherwise
    local tree_prefix="├─"
    if [[ "$next_disk" != "$disk" ]] || [[ -z "$next_disk" ]]; then
      tree_prefix="└─"
    fi

    # Add partition/free space entry with tree prefix
    # Format: tree_prefix device label (size MB) [boundaries/type]
    if [[ "$type" == "free" ]] && (( size >= 2048 )); then
      # Free space entry stores boundaries for later processing (only if >= 2GB)
      options+=("  $tree_prefix (free space) ($size MB) [DISK:$last_disk|START:$start|END:$end]")
    elif [[ "$type" != "free" ]]; then
      # Partition entry stores full path /dev/diskN
      # Extract full device path from label (e.g., "sda1" -> "/dev/sda1")
      local part_path="/dev/${label}"
      local warning=""
      # Check if partition is < 16GB and add warning
      if (( size < 16384 )); then
        warning=$(printf ' \033[31m[TOO SMALL - 16GB minimum required]\033[0m')
      fi
      options+=("  $tree_prefix $part_path ($label, $size MB) [${start}-${end} MB]$warning")
    fi
  done

  debug_echo "DEBUG: Total menu options: ${#options[@]}"
}

# === MAIN ===

declare -a unified_map
declare -a sorted_map

build_unified_mapfile unified_map
sort_mapfile unified_map sorted_map

# Conditional output based on mode flags
if [[ "$DISPLAY" == "true" ]]; then
  # Display mode: show mapfile layout
  display_merged_map sorted_map
elif [[ "$DEBUG" == "true" ]]; then
  # Debug mode: show debug output + mapfile layout
  display_merged_map sorted_map
else
  # Interactive menu mode: show gum choose menu
  declare -a gum_options
  build_gum_options sorted_map gum_options

  if (( ${#gum_options[@]} == 0 )); then
    echo "ERROR: No disks or partitions found" >&2
    exit 1
  fi

  # Initialize error message for validation loop
  error_message=""

  # Wrap selection in loop for validation (Gap #3)
  while true; do
    debug_echo "DEBUG: Launching gum choose menu with ${#gum_options[@]} options"

    # Display gum menu with error message in header if validation failed
    # Error message is embedded in header to display above menu options
    #header_text="Select install target (disk or partition)"
    #if [[ -n "$error_message" ]]; then
    #  header_text="$error_message $header_text"
    #fi

    #selected=$("gum" "choose" "--header" "$header_text" "--padding" "0 2" "${gum_options[@]}")

    header_text="Select install target (disk or partition)"
    selected="$("gum" "choose" "--header" "$error_message
$header_text" "--padding" "0 $PADDING_LEFT" "${gum_options[@]}")"

    if [[ -z "$selected" ]]; then
      echo "ERROR: No selection made" >&2
      exit 1
    fi

    debug_echo "DEBUG: User selected: $selected"

    # Extract device path from selection
    # The regex matches /dev/diskN or /dev/diskNM patterns (N=number, M=number)
    device=$(printf "%s\n" "$selected" | grep -oE '/dev/[a-z0-9]+' | tail -1)

    if [[ -z "$device" ]]; then
      echo "ERROR: Failed to extract device from selection: $selected" >&2
      exit 1
    fi

    debug_echo "DEBUG: Extracted device: $device"

    # Determine if this is a disk or partition selection
    if [[ "$selected" =~ ^[[:space:]]*[├└] ]]; then
      # Partition or free space selection (has tree prefix)
      debug_echo "DEBUG: User selected partition/free space: $device"

      # Gap #3: Validate partition size >= 16GB
      partition_size_bytes=$(lsblk -dno SIZE -b "$device" 2>/dev/null || echo "0")
      min_size_bytes=$((16 * 1024 * 1024 * 1024))

      debug_echo "DEBUG: Partition size check: $partition_size_bytes bytes vs minimum $min_size_bytes bytes"

      if (( partition_size_bytes >= min_size_bytes )); then
        # Size is valid, break loop to proceed
        debug_echo "DEBUG: Partition size valid, breaking loop"
        break
      else
        # Size is invalid, set error and continue loop for re-selection
        error_message="ERROR: Selected partition is too small. Minimum size required: 16GB (actual: $((partition_size_bytes / 1024 / 1024 / 1024))GB)"
        debug_echo "DEBUG: $error_message"
        continue
      fi
    else
      # Disk selection (no tree prefix)
      debug_echo "DEBUG: User selected disk: $device"
      # Disk selections don't require size validation
      break
    fi
  done

  # Output selected device
  echo "$device"
fi
