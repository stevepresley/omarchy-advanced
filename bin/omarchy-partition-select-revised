#!/bin/bash

# Partition selector using parted as single source of truth
# Parse 'parted disk print free' output to extract both partitions and free space regions
# in correct order and with correct boundaries

set -euo pipefail

if [[ -z "${OMARCHY_PATH:-}" ]]; then
  export OMARCHY_PATH="/root/omarchy"
fi

source "$OMARCHY_PATH/install/helpers/presentation.sh"

# === BUILD UNIFIED MAPFILE FROM PARTED OUTPUT ===
# Structure: disk|label|start_mb|end_mb|size_mb|type
# Extracts both partitions AND free space from single parted command per disk

build_unified_mapfile() {
  local -n result=$1
  local disks
  local temp_file

  result=()
  temp_file=$(mktemp)

  # Get all disk names only
  disks=$(lsblk -nd -o NAME 2>/dev/null | grep -E '^[a-z]+d$' || true)

  while read -r disk; do
    [[ -z "$disk" ]] && continue

    # Get BOTH partitions AND free space from single parted command
    local parted_output
    parted_output=$(sudo parted "/dev/$disk" print free 2>/dev/null || echo "")

    # Parse parted output for both partition lines and free space lines
    # Partition lines: have a number in first column
    # Free space lines: start with whitespace, contain "Free Space" text
    echo "$parted_output" | awk -v disk="$disk" '
      # Skip header/footer lines and empty lines
      /^[[:space:]]*$/ { next }
      /^Number/ { next }
      /^Disk / { next }
      /^Sector/ { next }
      /^Partition Table/ { next }
      /^Disk Flags/ { next }
      /^Model:/ { next }

      # Match partition lines: "Number  Start   End     Size    ..."
      /^[[:space:]]*[0-9]+[[:space:]]+/ {
        # Partition line: extract fields
        # $1=number, $2=start, $3=end, $4=size, remaining=type/filesystem/flags
        start_str = $2
        end_str = $3
        partition_num = $1

        # Verify we have valid unit suffixes
        if (start_str !~ /[kMG]?B$/ || end_str !~ /[kMG]?B$/) {
          next
        }

        # Convert start to MB
        if (start_str ~ /GB$/) {
          start_mb = substr(start_str, 1, length(start_str)-2) * 1024
        } else if (start_str ~ /MB$/) {
          start_mb = substr(start_str, 1, length(start_str)-2)
        } else if (start_str ~ /kB$/) {
          start_mb = substr(start_str, 1, length(start_str)-2) / 1024
        } else if (start_str ~ /B$/) {
          start_mb = substr(start_str, 1, length(start_str)-1) / 1048576
        } else {
          next
        }

        # Convert end to MB
        if (end_str ~ /GB$/) {
          end_mb = substr(end_str, 1, length(end_str)-2) * 1024
        } else if (end_str ~ /MB$/) {
          end_mb = substr(end_str, 1, length(end_str)-2)
        } else if (end_str ~ /kB$/) {
          end_mb = substr(end_str, 1, length(end_str)-2) / 1024
        } else if (end_str ~ /B$/) {
          end_mb = substr(end_str, 1, length(end_str)-1) / 1048576
        } else {
          next
        }

        size_mb = int(end_mb - start_mb)
        partition_name = disk partition_num
        printf "%s|%s|%.0f|%.0f|%d|part\n", disk, partition_name, start_mb, end_mb, size_mb
        next
      }

      # Match free space lines: whitespace at start AND contains "Free Space"
      /^[[:space:]]+/ && /Free Space/ {
        # Free space line: extract fields
        # Format: "        start   end     size    Free Space"
        start_str = $1
        end_str = $2

        # Verify we have valid unit suffixes
        if (start_str !~ /[kMG]?B$/ || end_str !~ /[kMG]?B$/) {
          next
        }

        # Convert start to MB
        if (start_str ~ /GB$/) {
          start_mb = substr(start_str, 1, length(start_str)-2) * 1024
        } else if (start_str ~ /MB$/) {
          start_mb = substr(start_str, 1, length(start_str)-2)
        } else if (start_str ~ /kB$/) {
          start_mb = substr(start_str, 1, length(start_str)-2) / 1024
        } else if (start_str ~ /B$/) {
          start_mb = substr(start_str, 1, length(start_str)-1) / 1048576
        } else {
          next
        }

        # Convert end to MB
        if (end_str ~ /GB$/) {
          end_mb = substr(end_str, 1, length(end_str)-2) * 1024
        } else if (end_str ~ /MB$/) {
          end_mb = substr(end_str, 1, length(end_str)-2)
        } else if (end_str ~ /kB$/) {
          end_mb = substr(end_str, 1, length(end_str)-2) / 1024
        } else if (end_str ~ /B$/) {
          end_mb = substr(end_str, 1, length(end_str)-1) / 1048576
        } else {
          next
        }

        size_mb = int(end_mb - start_mb)
        printf "%s|free|%.0f|%.0f|%d|free\n", disk, start_mb, end_mb, size_mb
        next
      }
    ' >> "$temp_file"
  done <<< "$disks"

  # Read from temp file and populate array
  while IFS='|' read -r disk label start end size type; do
    result+=("$disk|$label|$start|$end|$size|$type")
  done < "$temp_file"

  rm -f "$temp_file"
}

# === BUILD MAPFILE #3: MERGED AND ORDERED ===

build_merged_mapfile() {
  local -n partitions=$1
  local -n freespace=$2
  local -n result=$3
  local temp_combined
  local temp_sorted

  result=()
  temp_combined=$(mktemp)
  temp_sorted=$(mktemp)

  # Write partitions to combined file
  for entry in "${partitions[@]}"; do
    echo "$entry" >> "$temp_combined"
  done

  # Write freespace to combined file
  for entry in "${freespace[@]}"; do
    echo "$entry" >> "$temp_combined"
  done

  # Sort the combined entries to a separate file
  # Sort by: disk name (field 1), then by start position (field 3 numerically)
  sort -t'|' -k1,1 -k3,3n "$temp_combined" > "$temp_sorted"

  # Read sorted file into array
  while IFS='|' read -r disk label start end size type; do
    result+=("$disk|$label|$start|$end|$size|$type")
  done < "$temp_sorted"

  rm -f "$temp_combined" "$temp_sorted"
}

# === DISPLAY MERGED MAP ===

display_merged_map() {
  local -n merged=$1

  echo "=== Disk Layout Map ==="
  echo ""

  if [[ ${#merged[@]} -eq 0 ]]; then
    echo "No partitions or free space found"
    return
  fi

  local current_disk=""
  for entry in "${merged[@]}"; do
    IFS='|' read -r disk label start end size type <<< "$entry"

    # New disk header
    if [[ "$disk" != "$current_disk" ]]; then
      [[ -n "$current_disk" ]] && echo ""
      echo "Disk: /dev/$disk"
      echo "  Position (MB) | Label | Size (MB) | Type"
      echo "  ============================================"
      current_disk="$disk"
    fi

    printf "  %6s - %-6s | %-15s | %8s | %s\n" "$start" "$end" "$label" "$size" "$type"
  done
}

# === MAIN ===

declare -a partitions_map
declare -a freespace_map
declare -a merged_map

build_partitions_mapfile partitions_map
build_freespace_mapfile freespace_map
build_merged_mapfile partitions_map freespace_map merged_map

display_merged_map merged_map

echo ""
echo "Total entries in merged map: ${#merged_map[@]}"
echo ""
if [[ ${#merged_map[@]} -gt 0 ]]; then
  echo "Mapfile structure (disk|label|start_mb|end_mb|size_mb|type):"
  for entry in "${merged_map[@]}"; do
    echo "  $entry"
  done
fi
